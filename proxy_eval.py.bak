#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
from pathlib import Path

import numpy as np
import torch

from torch.utils.data import DataLoader

from src.checkpoint import torch_load
from src.data import CSIGImageDataset
from src.model import build_model


def parse_args():

    p = argparse.ArgumentParser()

    p.add_argument(
        "--root",
        required=True,
    )

    p.add_argument(
        "--ckpt",
        required=True,
    )

    p.add_argument(
        "--train-category-file",
        required=True,
    )

    p.add_argument(
        "--holdout-category-file",
        required=True,
    )

    p.add_argument(
        "--output-json",
        required=True,
    )

    p.add_argument(
        "--batch-size",
        type=int,
        default=2,
    )

    return p.parse_args()


def load_model(
    path,
    device,
):

    checkpoint = torch_load(
        path,
        map_location="cpu",
    )

    cfg = checkpoint["args"]

    model = build_model(
        encoder_name=cfg["encoder"],
        inp_num=cfg["inp_num"],
        decoder_depth=cfg[
            "decoder_depth"
        ],
        residual_strength=cfg[
            "residual_strength"
        ],
        encoder_source=cfg[
            "encoder_source"
        ],
    ).to(device)

    model.load_state_dict(
        checkpoint["model"],
        strict=True,
    )

    model.eval()

    return model, cfg


def score_batch(
    amap,
):

    flat = amap.flatten(1)

    k = max(
        1,
        int(
            flat.shape[1]
            * 0.01
        ),
    )

    return torch.topk(
        flat,
        k,
        dim=1,
    ).values.mean(1)


@torch.no_grad()
def collect_clean(
    model,
    loader,
    device,
):

    scores = []

    for images, _ in loader:

        images = images.to(
            device
        )

        output = model(
            images,
            return_maps=True,
        )

        scores.extend(
            score_batch(
                output[
                    "pixel_map"
                ]
            )
            .cpu()
            .tolist()
        )

    return np.asarray(
        scores,
        dtype=np.float64,
    )


@torch.no_grad()
def collect_synthetic(
    model,
    loader,
    device,
):

    image_scores = []
    f1_scores = []

    for batch in loader:

        images = (
            batch["synthetic"]
            .to(device)
        )

        target = (
            batch["mask"]
            .to(device)
        )

        output = model(
            images,
            return_maps=True,
        )

        amap = output[
            "pixel_map"
        ]

        image_scores.extend(
            score_batch(
                amap
            )
            .cpu()
            .tolist()
        )

        # F1max approximation over fixed validation thresholds.
        best = torch.zeros(
            amap.shape[0],
            device=device,
        )

        for threshold in torch.linspace(
            0.05,
            0.95,
            19,
            device=device,
        ):

            pred = (
                amap
                >= threshold
            ).float()

            tp = (
                pred
                * target
            ).flatten(1).sum(1)

            fp = (
                pred
                * (
                    1 - target
                )
            ).flatten(1).sum(1)

            fn = (
                (
                    1 - pred
                )
                * target
            ).flatten(1).sum(1)

            f1 = (
                2 * tp
                / (
                    2 * tp
                    + fp
                    + fn
                    + 1e-6
                )
            )

            best = torch.maximum(
                best,
                f1
            )

        f1_scores.extend(
            best.cpu().tolist()
        )

    return (
        np.asarray(
            image_scores,
            dtype=np.float64,
        ),
        np.asarray(
            f1_scores,
            dtype=np.float64,
        ),
    )


def main():

    args = parse_args()

    device = torch.device(
        "cuda"
        if torch.cuda.is_available()
        else "cpu"
    )

    train_categories = set(
        json.loads(
            Path(
                args.train_category_file
            ).read_text()
        )
    )

    holdout_categories = set(
        json.loads(
            Path(
                args.holdout_category_file
            ).read_text()
        )
    )

    model, cfg = load_model(
        args.ckpt,
        device,
    )

    image_size = int(
        cfg["image_size"]
    )

    train_clean = (
        CSIGImageDataset(
            args.root,
            image_size=image_size,
            synthetic_anomaly=False,
            include_categories=(
                train_categories
            ),
        )
    )

    holdout_clean = (
        CSIGImageDataset(
            args.root,
            image_size=image_size,
            synthetic_anomaly=False,
            include_categories=(
                holdout_categories
            ),
        )
    )

    holdout_syn = (
        CSIGImageDataset(
            args.root,
            image_size=image_size,
            synthetic_anomaly=True,
            synthetic_prob=1.0,
            include_categories=(
                holdout_categories
            ),
            deterministic_synthetic=True,
            synthetic_seed=913751,
        )
    )

    loader_kwargs = {
        "batch_size":
            args.batch_size,

        "shuffle":
            False,

        "num_workers":
            2,

        "pin_memory":
            (
                device.type
                == "cuda"
            ),
    }

    train_scores = collect_clean(
        model,
        DataLoader(
            train_clean,
            **loader_kwargs,
        ),
        device,
    )

    holdout_scores = collect_clean(
        model,
        DataLoader(
            holdout_clean,
            **loader_kwargs,
        ),
        device,
    )

    synthetic_scores, f1 = (
        collect_synthetic(
            model,
            DataLoader(
                holdout_syn,
                **loader_kwargs,
            ),
            device,
        )
    )

    train_normal = float(
        np.mean(
            train_scores
        )
    )

    holdout_normal = float(
        np.mean(
            holdout_scores
        )
    )

    synthetic_mean = float(
        np.mean(
            synthetic_scores
        )
    )

    normal_gap = (
        holdout_normal
        / max(
            train_normal,
            1e-8,
        )
    )

    # Separation from the actual unseen-normal baseline.
    sensitivity = (
        synthetic_mean
        / max(
            holdout_normal,
            1e-8,
        )
    )

    result = {
        "train_normal":
            train_normal,

        "holdout_normal":
            holdout_normal,

        "normal_gap":
            normal_gap,

        "synthetic":
            synthetic_mean,

        "separation":
            sensitivity,

        "pixel_f1":
            float(
                np.mean(f1)
            ),
    }

    Path(
        args.output_json
    ).write_text(
        json.dumps(
            result,
            indent=2,
        ),
        encoding="utf-8",
    )

    print(
        json.dumps(
            result,
            indent=2,
        )
    )


if __name__ == "__main__":
    main()
